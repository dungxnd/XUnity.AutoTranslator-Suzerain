<Project Sdk="Microsoft.NET.Sdk">

   <PropertyGroup>
      <TargetFramework>net35</TargetFramework>
      <LangVersion>latest</LangVersion>
      <Nullable>enable</Nullable>
      <ImplicitUsings>disable</ImplicitUsings>
      <AssemblyName>XUnity.AutoTranslator.LlmTranslators</AssemblyName>
      <RootNamespace>XUnity.AutoTranslator.LlmTranslators</RootNamespace>
      <PackageLicenseExpression>MIT</PackageLicenseExpression>
   </PropertyGroup>

   <ItemGroup>
      <ProjectReference Include="..\..\XUnity.AutoTranslator.Plugin.Core\XUnity.AutoTranslator.Plugin.Core.csproj" />
      <ProjectReference Include="..\..\XUnity.Common\XUnity.Common.csproj" />
   </ItemGroup>

   <ItemGroup>
      <PackageReference Include="YamlDotNet" Version="5.0.0" />
      <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.45" PrivateAssets="All" />
   </ItemGroup>

   <ItemGroup>
      <None Update="SampleConfig\LLMConfig.yaml" CopyToOutputDirectory="PreserveNewest" />
   </ItemGroup>

   <Target Name="PostBuild" AfterTargets="ILRepacker" Condition="'$(Configuration)' == 'Release'">
      <ItemGroup>
         <ReleaseFiles Include="$(TargetPath)" />
         <ReleaseFiles Include="$(MSBuildThisFileDirectory)SampleConfig\LLMConfig.yaml" />
      </ItemGroup>

      <MakeDir Directories="$(SolutionDir)dist\Translators" Condition="'$(SolutionDir)' != '' and '$(SolutionDir)' != '*Undefined*'" />
      <Copy SourceFiles="@(ReleaseFiles)" DestinationFolder="$(SolutionDir)dist\Translators" Condition="'$(SolutionDir)' != '' and '$(SolutionDir)' != '*Undefined*'" />
   </Target>

</Project>
