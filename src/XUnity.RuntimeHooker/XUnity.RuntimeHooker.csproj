<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\XUnity.RuntimeHooker.Core\XUnity.RuntimeHooker.Core.csproj" />
    <ProjectReference Include="..\XUnity.RuntimeHooker.Trampolines\XUnity.RuntimeHooker.Trampolines.csproj" ReferenceOutputAssembly="false" OutputItemType="TrampolinesAssembly" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="CopyTrampolines" BeforeTargets="BeforeResGen" DependsOnTargets="ResolveReferences">
    <Copy SourceFiles="@(TrampolinesAssembly)" DestinationFolder="$(MSBuildThisFileDirectory)Resources" SkipUnchangedFiles="true" />
  </Target>

</Project>
